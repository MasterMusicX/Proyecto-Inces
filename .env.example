APP_NAME="INCES LMS"
APP_ENV=local
APP_KEY=base64:jaNXYlfxM+RUtLnwtOU9Hx05mWkRYhFk4ABKfBDdTV4=
APP_DEBUG=true
APP_TIMEZONE=America/Caracas
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS (LOCAL)
# ==========================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=inces_lms
DB_USERNAME=postgres
DB_PASSWORD=tu_clave_local_aqui

# ==========================================
# DRIVERS Y SESIONES
# ==========================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ==========================================
# CONFIGURACIÓN DE CORREOS (GMAIL)
# ==========================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_token_de_aplicacion_gmail_aqui
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=tu_correo@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================
# INTELIGENCIA ARTIFICIAL (GROQ CLOUD)
# ==========================================
GROQ_API_KEY=tu_groq_api_key_aqui
GROQ_MODEL=llama3-8b-8192

# ==========================================
# GESTIÓN DE ARCHIVOS E IMÁGENES (IMGBB)
# ==========================================
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,jpg,jpeg,png,gif
IMGBB_API_KEY=tu_imgbb_api_key_aqui